---
const base = import.meta.env.BASE_URL;

const links = {
  linkedin: 'https://linkedin.com/in/jaredelgado',
  github: 'https://github.com/Jarben-Singh',
  cv: `${base}cv.pdf`,
};

// 8-bit icons: '#' = filled pixel, '.' = empty
const icons = {
  linkedin: [
    '##########',
    '##.#######',
    '##########',
    '##.#....##',
    '##.#.##.##',
    '##.#.##.##',
    '##.#.##.##',
    '##.#.##.##',
    '##########',
    '##########',
  ],
  github: [
    '.#........#.',
    '.##########.',
    '############',
    '##.######.##',
    '############',
    '############',
    '.##########.',
    '..########..',
    '...######...',
    '...##..##...',
  ],
  download: [
    '....##....',
    '....##....',
    '....##....',
    '....##....',
    '..######..',
    '...####...',
    '....##....',
    '..........',
    '##########',
    '##########',
  ],
};

const pixels = (rows: string[]) =>
  rows.flatMap((row, y) =>
    [...row].flatMap((c, x) => (c === '#' ? [{ x, y }] : [])),
  );
---

<section id="about" class="w-full relative pt-6 md:pt-10 pb-4">
  <div class="grid grid-cols-1 md:grid-cols-[auto_1fr] gap-8 md:gap-12 items-center">
    <!-- Avatar -->
    <div class="flex justify-center md:justify-start">
      <div class="p-2 bg-[#0600AB] w-fit">
        <div class="p-2 bg-gradient-to-b from-[#ffd7f3] via-[#cbbeff] to-[#4d2eb0]">
          <div
            class="relative w-48 h-48 sm:w-56 sm:h-56 bg-surface-container-lowest border-4 border-[#0600AB] overflow-hidden"
          >
            <img
              alt="Pixel art avatar of Jared Delgado"
              class="w-full h-full object-cover [image-rendering:pixelated]"
              src={`${base}img/avatar-v3.png`}
            />
            <div class="absolute top-1 left-1 w-2 h-2 bg-white"></div>
            <div class="absolute top-1 right-1 w-2 h-2 bg-white"></div>
            <div class="absolute bottom-1 left-1 w-2 h-2 bg-white"></div>
            <div class="absolute bottom-1 right-1 w-2 h-2 bg-white"></div>
          </div>
        </div>
        <div class="flex justify-between items-center mt-2">
          <span
            class="font-pixel text-[8px] bg-surface-container-lowest text-primary-fixed px-2 py-1 border border-primary-container"
            >PLAYER 1</span
          >
          <span class="font-pixel text-[8px] bg-[#1f41ff] text-white px-2 py-1">LVL 19</span>
        </div>
      </div>
    </div>

    <!-- Bio -->
    <div class="flex flex-col gap-4 min-w-0">
      <div>
        <h1
          class="font-pixel text-2xl sm:text-3xl md:text-4xl text-white leading-tight tracking-wider"
        >
          JARED DELGADO
        </h1>
        <p class="font-pixel text-[11px] sm:text-xs text-[#ffd7f3] tracking-widest mt-2">
          FULL STACK DEVELOPER
        </p>
      </div>

      <p class="font-body-md text-body-md text-[#f1eaff] leading-snug max-w-md">
        Software Engineering student focused on process optimization and driven by curiosity for
        low-level systems, from web apps to SNES-era hardware.
      </p>

      <div class="flex flex-wrap items-center gap-3 pt-3">
        {
          [
            { label: 'LINKEDIN', href: links.linkedin, icon: 'linkedin', ext: true },
            { label: 'GITHUB', href: links.github, icon: 'github', ext: true },
            { label: 'DOWNLOAD CV', href: links.cv, icon: 'download', ext: false },
          ].map((b) => {
            const rows = icons[b.icon as keyof typeof icons];
            return (
              <a
                class="inline-flex items-center gap-2.5 px-3 py-2 text-white font-label-md text-[11px] tracking-wider uppercase border border-[#dfe0ff] hover:bg-white hover:text-surface-container-lowest transition-colors"
                href={b.href}
                target={b.ext ? '_blank' : undefined}
                rel={b.ext ? 'noopener noreferrer' : undefined}
                download={b.ext ? undefined : ''}
              >
                <svg
                  class="w-3.5 h-3.5 shrink-0"
                  viewBox={`0 0 ${rows[0].length} ${rows.length}`}
                  shape-rendering="crispEdges"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  {pixels(rows).map((p) => (
                    <rect x={p.x} y={p.y} width="1" height="1" />
                  ))}
                </svg>
                {b.label}
              </a>
            );
          })
        }
      </div>
    </div>
  </div>
</section>
