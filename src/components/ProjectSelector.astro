---
import { projects, platforms, type Localized, type Platform } from '../data/projects';
import T from './T.astro';

const base = import.meta.env.BASE_URL;

// Estrella pixel-art 7x7
const star = [
  '...#...',
  '...#...',
  '#######',
  '.#####.',
  '..###..',
  '.##.##.',
  '.#...#.',
];
const starRects = star.flatMap((row, y) =>
  [...row.matchAll(/#+/g)].map((m) => ({ x: m.index!, y, w: m[0].length })),
);

const ui = {
  heading: { en: 'SELECT A PROJECT', es: 'ELIGE UN PROYECTO' },
  filters: { en: 'Filter by platform', es: 'Filtrar por plataforma' },
  nowPlaying: { en: 'NOW PLAYING', es: 'EN JUEGO' },
  noSignal: { en: 'NO SIGNAL', es: 'SIN SEÑAL' },
  denied: { en: 'ACCESS DENIED', es: 'ACCESO DENEGADO' },
  stage: { en: 'STAGE 02 IN PROGRESS', es: 'STAGE 02 EN PROGRESO' },
  more: { en: 'MORE DETAILS', es: 'MÁS DETALLES' },
  nextCh: { en: 'Next channel (next project)', es: 'Siguiente canal (siguiente proyecto)' },
  locked: { en: 'LOCKED', es: 'BLOQUEADO' },
} satisfies Record<string, Localized<string>>;

const platformLabel = Object.fromEntries(platforms.map((p) => [p.id, p.label])) as Record<
  Platform,
  Localized<string>
>;

// Solo se muestran los filtros que tienen al menos un proyecto (más ALL).
const filters = platforms.filter(
  (f) => f.id === 'ALL' || projects.some((p) => p.platform === f.id),
);

// Al cargar aparece seleccionado Focus Focus.
const initial = Math.max(
  0,
  projects.findIndex((p) => p.title === 'Focus Focus'),
);

const channel = (i: number) => `CH${String(i + 1).padStart(2, '0')}`;

// Antena de conejo en pixel art (rejilla de 48×20, se muestra a ×3).
const antenna = [
  // varilla izquierda: diagonal a 45°
  ...Array.from({ length: 14 }, (_, k) => ({ x: 22 - k, y: 15 - k, w: 1, h: 1, c: 'rod' })),
  // varilla derecha: más empinada
  ...Array.from({ length: 7 }, (_, k) => ({ x: 25 + k, y: 14 - 2 * k, w: 1, h: 2, c: 'rod' })),
  // puntas
  { x: 7, y: 0, w: 3, h: 3, c: 'tip' },
  { x: 31, y: 0, w: 3, h: 3, c: 'tip' },
  // base
  { x: 20, y: 16, w: 8, h: 1, c: 'hi' },
  { x: 18, y: 17, w: 12, h: 2, c: 'mid' },
  { x: 18, y: 19, w: 12, h: 1, c: 'lo' },
];
---

<section id="project-grid" class="w-full mt-12" aria-labelledby="pg-title">
  <!-- Header -->
  <div
    class="bg-surface-container border-4 border-outline-variant shadow-[4px_4px_0px_0px_#01043e] p-4 flex items-center gap-3"
  >
    <div
      class="w-7 h-7 bg-tertiary border-2 border-surface-container-lowest flex items-center justify-center shrink-0 shadow-[2px_2px_0_#01043e]"
    >
      <span class="font-pixel text-[10px] text-surface-container-lowest font-bold animate-pulse"
        >$</span
      >
    </div>
    <h2 id="pg-title" class="font-pixel text-sm sm:text-base text-primary-fixed tracking-wide">
      <T v={ui.heading} />
    </h2>
  </div>

  <!-- Filtros -->
  <div class="pg-filters" role="group" aria-labelledby="pg-filters-label">
    <span id="pg-filters-label" class="sr-only"><T v={ui.filters} /></span>
    {
      filters.map((p) => (
        <button
          type="button"
          class="fbtn"
          data-filter={p.id}
          aria-pressed={String(p.id === 'ALL')}
        >
          <T v={p.label} />
        </button>
      ))
    }
  </div>

  <div class="pg-layout">
    <!-- Estante -->
    <div class="shelf" data-shelf role="group" aria-labelledby="pg-title">
      {
        projects.map((p, i) => (
          <button
            type="button"
            class:list={['cart', !p.cartridge && 'cart-css', p.locked && 'locked']}
            data-cart
            data-platform={p.platform ?? ''}
            aria-pressed={String(i === initial)}
            aria-controls="pg-screen"
            tabindex={i === initial ? 0 : -1}
            style={p.label ? `--lbl: var(--color-${p.label})` : undefined}
          >
            <span class="cur" aria-hidden="true">
              ▶
            </span>
            {p.cartridge ? (
              <img
                class="art"
                src={`${base}${p.cartridge}`}
                alt={p.title}
                width="128"
                height="80"
                draggable="false"
              />
            ) : (
              <>
                <span class="shell" aria-hidden="true" />
                <span class="face" aria-hidden="true" />
                <span class="lbl">
                  <b>{p.title}</b>
                </span>
                <span class="groove" aria-hidden="true" />
              </>
            )}
            {p.locked && (
              <span class="sr-only">
                (<T v={ui.locked} />)
              </span>
            )}
          </button>
        ))
      }
    </div>

    <!-- Tele -->
    <div class="tv" data-tv style={`--ch: ${initial}`}>
      <svg
        class="tv-antenna"
        viewBox="0 0 48 20"
        shape-rendering="crispEdges"
        aria-hidden="true"
      >
        {antenna.map((r) => <rect x={r.x} y={r.y} width={r.w} height={r.h} class={`a-${r.c}`} />)}
      </svg>
      <div class="tv-cabinet">
        <div class="tv-bezel">
          <div class="tv-tube">
            <div class="tv-screen" id="pg-screen" data-screen aria-live="polite">
              {
                projects.map((p, i) => (
                  <div class="tv-panel" data-panel data-active={i === initial ? '' : undefined}>
                    <div class="tv-hd">
                      <T v={p.locked ? ui.noSignal : ui.nowPlaying} />
                      <span class="rec">● SLOT A</span>
                    </div>
                    <h3 class="tv-title">{p.locked ? p.title.toUpperCase() : p.title}</h3>
                    {p.platform && (
                      <p class="tv-sub">
                        <T v={platformLabel[p.platform]} />
                      </p>
                    )}
                    {p.locked && (
                      <p class="denied">
                        <T v={ui.denied} />
                        <br />
                        <T v={ui.stage} />
                      </p>
                    )}
                    {(['en', 'es'] as const).map((lang) => (
                      <ul class="stars" data-lang={lang}>
                        {p.features[lang].map((feature) => (
                          <li>
                            <svg viewBox="0 0 7 7" shape-rendering="crispEdges" aria-hidden="true">
                              {starRects.map((r) => (
                                <rect x={r.x} y={r.y} width={r.w} height="1" fill="currentColor" />
                              ))}
                            </svg>
                            <span>{feature}</span>
                          </li>
                        ))}
                      </ul>
                    ))}
                    {p.stack.length > 0 && (
                      <ul class="chips" aria-label="Stack">
                        {p.stack.map((s) => (
                          <li>{s}</li>
                        ))}
                      </ul>
                    )}
                    <div class="tv-actions">
                      {p.locked ? (
                        <span class="inline-block px-8 py-2 border-2 border-outline-variant font-pixel text-[10px] text-outline cursor-not-allowed">
                          <T v={ui.locked} />
                        </span>
                      ) : (
                        <a
                          href={p.href}
                          class="more-btn"
                        >
                          <T v={ui.more} /> ▶
                        </a>
                      )}
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
        <!-- Panel de controles lateral -->
        <div class="tv-side">
          <span class="tv-brand" aria-hidden="true">JD-19</span>
          <span class="tv-ch" data-ch aria-hidden="true">{channel(initial)}</span>
          <!-- La perilla CH cambia al siguiente proyecto -->
          <button
            type="button"
            class="knob-wrap knob-btn"
            data-next-ch
            aria-controls="pg-screen"
          >
            <span class="knob" aria-hidden="true"
              ><span class="knob-cap" data-knob="ch"></span></span
            >
            <span class="knob-lbl" aria-hidden="true">CH</span>
            <span class="sr-only"><T v={ui.nextCh} /></span>
          </button>
          <span class="knob-wrap" aria-hidden="true">
            <span class="knob"><span class="knob-cap" data-knob="vol"></span></span>
            <span class="knob-lbl">VOL</span>
          </span>
          <span class="tv-grille" aria-hidden="true"></span>
          <span class="tv-btns" aria-hidden="true"><span></span><span></span><span></span></span>
        </div>
        <div class="tv-base" aria-hidden="true">
          <span class="led"></span><span>POWER</span><span class="tv-slot"></span><span
            >PLAYER 1</span
          >
        </div>
      </div>
      <div class="tv-feet" aria-hidden="true"></div>
    </div>
  </div>
</section>

<style>
  #project-grid {
    /* Grises del cartucho: la paleta del arte de 128×80 (cartridge-focus.png) */
    --shell: #a0a0a3;
    --shell-hi: #cfcfcf;
    --shell-lo: #777777;
    --shell-edge: #4b4b4b;
    --shell-outline: #ffffff;
    --star: #ffd23f;
    --shadow: var(--color-surface-container-lowest);
  }

  #project-grid :focus-visible {
    outline: 3px solid var(--star);
    outline-offset: 3px;
  }

  /* ---------- filtros ---------- */
  .pg-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 2rem;
    margin-bottom: 1.25rem;
  }
  .fbtn {
    font-family: var(--font-pixel);
    font-size: 9px;
    letter-spacing: 0.06em;
    padding: 9px 10px 8px;
    background: var(--color-surface-container);
    color: var(--color-on-surface-variant);
    box-shadow: inset 0 0 0 2px var(--color-outline-variant);
    cursor: pointer;
  }
  .fbtn:hover {
    color: var(--color-on-surface);
    box-shadow: inset 0 0 0 2px var(--color-secondary);
  }
  .fbtn[aria-pressed='true'] {
    background: var(--color-primary-container);
    color: var(--color-tertiary-fixed);
    box-shadow: inset 0 0 0 2px var(--color-tertiary-fixed);
  }

  /* ---------- layout ---------- */
  /* El estante mide justo lo que ocupan 2 cartuchos a ×2 (588px); la tele
     se queda con el resto, mínimo 340px. */
  .pg-layout {
    display: grid;
    grid-template-columns: minmax(0, 588px) minmax(340px, 1fr);
    gap: 24px;
    align-items: start;
  }

  /* ---------- estante ---------- */
  .shelf {
    container: shelf / inline-size;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 36px 28px;
    padding: 30px 20px;
    background: var(--color-surface-container);
    border: 4px solid var(--color-outline-variant);
    box-shadow: 4px 4px 0 0 var(--shadow);
  }

  /* Proporción de un cartucho real (135×85 mm ≈ 8:5). El arte se dibuja a
     128×80 px y se muestra a escala entera: ×2 si caben 2 por fila a 256px
     (ver @container abajo), ×1 si no. `--u` es un píxel del arte. */
  .cart {
    --u: 1px;
    position: relative;
    display: block;
    justify-self: center;
    width: calc(var(--u) * 128);
    max-width: 100%;
    aspect-ratio: 8 / 5;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    container-type: inline-size;
    filter: drop-shadow(calc(var(--u) * 3) calc(var(--u) * 3) 0 var(--shadow));
    transition:
      transform 0.16s steps(3),
      opacity 0.2s steps(4),
      filter 0.2s steps(4);
  }
  @container shelf (min-width: 540px) {
    .cart {
      --u: 2px;
    }
    .cur {
      left: -22px;
      font-size: 14px;
    }
  }
  .cart:hover {
    transform: translateY(calc(var(--u) * -2));
  }
  .cart[aria-pressed='true'] {
    transform: translateY(calc(var(--u) * -5));
  }
  .cart:focus-visible {
    outline-offset: 6px;
  }
  .cart.dim {
    opacity: 0.3;
    filter: grayscale(1) drop-shadow(calc(var(--u) * 3) calc(var(--u) * 3) 0 var(--shadow));
  }

  /* cursor ▶ */
  .cur {
    position: absolute;
    left: -17px;
    top: 50%;
    translate: 0 -50%;
    font-family: var(--font-pixel);
    font-size: 10px;
    line-height: 1;
    color: var(--star);
    opacity: 0;
  }
  .cart[aria-pressed='true'] .cur {
    opacity: 1;
    animation: pg-blink 1s steps(1) infinite;
  }
  @keyframes pg-blink {
    50% {
      opacity: 0;
    }
  }

  /* arte PNG de 128×80 */
  .art {
    display: block;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
  }

  /* Cartucho dibujado en CSS para proyectos sin arte. Sigue la silueta del
     arte de 128×80: hombros más bajos con ranuras, cara central, etiqueta
     enmarcada en negro y ranura inferior. */
  .shell {
    position: absolute;
    inset: 6.25% 0 0;
    background: repeating-linear-gradient(
        to bottom,
        var(--shell) 0 calc(var(--u) * 9),
        var(--shell-lo) calc(var(--u) * 9) calc(var(--u) * 10),
        var(--shell-edge) calc(var(--u) * 10) calc(var(--u) * 11)
      )
      0 var(--u);
    box-shadow: inset 0 0 0 var(--u) var(--shell-outline);
  }
  .face {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 14.8%;
    right: 14.8%;
    background: var(--shell);
    border: var(--u) solid var(--shell-outline);
    border-bottom: 0;
  }
  .lbl {
    position: absolute;
    left: 18%;
    right: 18%;
    top: 0;
    height: 45%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--u) calc(var(--u) * 3);
    background: var(--lbl, var(--color-primary-container));
    border: calc(var(--u) * 3) solid #000;
    border-top-width: var(--u);
    box-shadow: 0 var(--u) 0 var(--shell-hi);
    overflow: hidden;
  }
  .lbl b {
    font-family: var(--font-pixel);
    font-weight: 400;
    font-size: clamp(6px, 5cqi, 13px);
    line-height: 1.35;
    color: #fff;
    text-align: center;
    text-transform: uppercase;
  }
  .groove {
    position: absolute;
    left: 18%;
    right: 18%;
    top: 60%;
    height: 8.75%;
    border: var(--u) solid var(--shell-lo);
    border-bottom-color: var(--shell-hi);
  }

  /* bloqueado: etiqueta en estática */
  .cart.locked .lbl {
    background:
      repeating-linear-gradient(
        90deg,
        rgb(223 224 255 / 0.16) 0 2px,
        transparent 2px 5px,
        rgb(1 4 62 / 0.55) 5px 7px,
        transparent 7px 11px
      ),
      repeating-linear-gradient(
        0deg,
        var(--color-surface-bright) 0 2px,
        var(--color-surface-container) 2px 3px,
        var(--color-outline-variant) 3px 6px,
        var(--color-surface-container-lowest) 6px 7px
      );
    background-size:
      13px 100%,
      100% 17px;
    animation: pg-static 0.5s steps(1) infinite;
  }
  .cart.locked .lbl b {
    padding: 2px 3px 1px;
    background: var(--color-surface-container-lowest);
    color: var(--color-on-surface-variant);
  }
  @keyframes pg-static {
    0% {
      background-position: 0 0, 0 0;
    }
    25% {
      background-position: 7px 0, 0 9px;
    }
    50% {
      background-position: 3px 0, 0 4px;
    }
    75% {
      background-position: 10px 0, 0 13px;
    }
  }

  /* ---------- tele ---------- */
  /* Tele de caja: antena de conejo, gabinete con esquinas escalonadas,
     marco hundido alrededor del tubo, panel lateral de perillas y bocina,
     franja inferior y patas. La sombra va en .tv con drop-shadow para que
     siga la silueta recortada (antena y patas incluidas).
     No se desplaza con el scroll: queda apoyada a la altura de la base
     del estante (align-self: end en la fila del grid). */
  .tv {
    --plastic: var(--color-on-surface-variant);
    --plastic-hi: var(--color-secondary-fixed);
    --plastic-lo: var(--color-outline);
    --plastic-dk: #5a5c70;
    --bezel: #2c2e40;
    --bezel-dk: #15161f;
    align-self: end;
    container: tv / inline-size;
    filter: drop-shadow(8px 8px 0 var(--color-indigo-shadow));
  }

  /* Esquinas en escalera de 2 pasos de --s */
  .tv-cabinet,
  .tv-bezel,
  .tv-tube,
  .knob,
  .knob-cap {
    --s2: calc(var(--s) * 2);
    clip-path: polygon(
      var(--s2) 0,
      calc(100% - var(--s2)) 0,
      calc(100% - var(--s2)) var(--s),
      calc(100% - var(--s)) var(--s),
      calc(100% - var(--s)) var(--s2),
      100% var(--s2),
      100% calc(100% - var(--s2)),
      calc(100% - var(--s)) calc(100% - var(--s2)),
      calc(100% - var(--s)) calc(100% - var(--s)),
      calc(100% - var(--s2)) calc(100% - var(--s)),
      calc(100% - var(--s2)) 100%,
      var(--s2) 100%,
      var(--s2) calc(100% - var(--s)),
      var(--s) calc(100% - var(--s)),
      var(--s) calc(100% - var(--s2)),
      0 calc(100% - var(--s2)),
      0 var(--s2),
      var(--s) var(--s2),
      var(--s) var(--s),
      var(--s2) var(--s)
    );
  }

  .tv-antenna {
    display: block;
    width: 144px;
    height: 60px;
    margin: 0 auto;
  }
  .a-rod {
    fill: var(--color-outline);
  }
  .a-tip {
    fill: var(--color-secondary-fixed);
  }
  .a-hi {
    fill: var(--color-secondary-fixed);
  }
  .a-mid {
    fill: var(--color-on-surface-variant);
  }
  .a-lo {
    fill: var(--color-outline);
  }

  .tv-cabinet {
    --s: 6px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 84px;
    gap: 14px;
    padding: 16px 16px 0;
    background: var(--plastic);
    box-shadow:
      inset 6px 6px 0 var(--plastic-hi),
      inset -6px -6px 0 var(--plastic-lo);
  }

  /* Marco hundido alrededor del tubo */
  .tv-bezel {
    --s: 4px;
    padding: 12px;
    background: var(--bezel);
    box-shadow:
      inset 4px 4px 0 var(--bezel-dk),
      inset -4px -4px 0 var(--plastic-dk);
  }

  /* El tubo: esquinas redondeadas en escalera, brillo y viñeta de CRT */
  .tv-tube {
    --s: 5px;
    position: relative;
  }
  .tv-tube::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 60% 40% at 22% 12%, rgb(255 255 255 / 0.09), transparent 70%),
      radial-gradient(ellipse at center, transparent 62%, rgb(0 0 0 / 0.5) 100%);
  }

  .tv-screen {
    position: relative;
    display: grid;
    padding: 22px 24px 24px;
    background: var(--color-surface-container-lowest);
    box-shadow: inset 0 0 0 4px #000;
    overflow: hidden;
  }
  .tv-screen::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: repeating-linear-gradient(
      to bottom,
      transparent 0 2px,
      rgb(0 0 0 / 0.28) 2px 3px
    );
  }
  .tv-screen.boot {
    animation: pg-boot 0.38s steps(5);
  }
  @keyframes pg-boot {
    0% {
      clip-path: inset(49% 0 49% 0);
      filter: brightness(4);
    }
    60% {
      clip-path: inset(10% 0 10% 0);
      filter: brightness(1.6);
    }
    100% {
      clip-path: inset(0);
      filter: none;
    }
  }

  /* Todos los paneles comparten la misma celda: la pantalla mide lo que el más
     alto y no cambia de tamaño al cambiar de cartucho. */
  .tv-panel {
    grid-area: 1 / 1;
    display: grid;
    gap: 14px;
    align-content: start;
    visibility: hidden;
  }
  .tv-panel[data-active] {
    visibility: visible;
  }

  .tv-hd {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-family: var(--font-pixel);
    font-size: 8px;
    letter-spacing: 0.08em;
    color: var(--color-outline);
  }
  .tv-hd .rec {
    color: var(--star);
  }
  .tv-title {
    font-family: var(--font-pixel);
    font-size: clamp(13px, 1.8vw, 17px);
    line-height: 1.45;
    color: #fff;
  }
  .tv-sub {
    margin-top: -6px;
    font-family: var(--font-pixel);
    font-size: 8px;
    letter-spacing: 0.08em;
    color: var(--color-secondary);
  }
  .denied {
    font-family: var(--font-pixel);
    font-size: 11px;
    line-height: 1.8;
    color: var(--color-tertiary-fixed);
  }
  .stars {
    display: grid;
    gap: 10px;
    font-family: var(--font-body-md);
    font-size: var(--text-body-sm);
    line-height: var(--text-body-sm--line-height);
    color: var(--color-on-surface);
  }
  .stars li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
  }
  .stars svg {
    flex: none;
    width: 14px;
    height: 14px;
    margin-top: 2px;
    color: var(--star);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chips li {
    padding: 2px 8px;
    font-family: var(--font-label-sm);
    font-size: 11px;
    color: var(--color-secondary);
    box-shadow: inset 0 0 0 2px var(--color-outline-variant);
  }
  .tv-actions {
    padding-top: 4px;
  }
  /* Botón MORE DETAILS: amarillo de las estrellas, con relieve pixel. Al
     pasar el mouse se aclara y se levanta; al presionarlo se hunde. */
  .more-btn {
    display: inline-block;
    padding: 9px 32px 8px;
    font-family: var(--font-pixel);
    font-size: 10px;
    color: var(--color-surface-container-lowest);
    background: var(--star);
    box-shadow:
      inset -3px -3px 0 #c99a12,
      inset 3px 3px 0 #ffe98a,
      4px 4px 0 #000;
    transition:
      background-color 0.12s steps(2),
      translate 0.12s steps(2),
      box-shadow 0.12s steps(2);
  }
  .more-btn:hover {
    background: #ffe36b;
    translate: -2px -2px;
    box-shadow:
      inset -3px -3px 0 #d9a91a,
      inset 3px 3px 0 #fff4c2,
      6px 6px 0 #000;
  }
  .more-btn:active {
    translate: 2px 2px;
    box-shadow:
      inset 3px 3px 0 #c99a12,
      2px 2px 0 #000;
  }

  /* ---------- panel lateral ---------- */
  .tv-side {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    padding: 12px 8px 14px;
    background: var(--plastic-lo);
    box-shadow:
      inset 3px 3px 0 var(--plastic-dk),
      inset -3px -3px 0 var(--plastic-hi);
  }
  .tv-brand {
    padding: 4px 5px 3px;
    font-family: var(--font-pixel);
    font-size: 7px;
    letter-spacing: 0.08em;
    color: var(--plastic-hi);
    background: var(--bezel);
    box-shadow: inset -2px -2px 0 #000;
  }
  .tv-ch {
    min-width: 56px;
    padding: 6px 4px 5px;
    font-family: var(--font-pixel);
    font-size: 9px;
    text-align: center;
    color: var(--star);
    text-shadow: 0 0 4px rgb(255 210 63 / 0.7);
    background: #000;
    box-shadow:
      inset 2px 2px 0 var(--bezel-dk),
      0 0 0 2px var(--plastic-dk);
  }
  .knob-wrap {
    display: grid;
    justify-items: center;
    gap: 5px;
  }
  .knob {
    --s: 4px;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    background: var(--bezel);
  }
  .knob-cap {
    --s: 4px;
    position: relative;
    width: 32px;
    height: 32px;
    background: linear-gradient(135deg, var(--plastic-hi) 0 50%, var(--plastic) 50%);
    rotate: calc(var(--ch, 0) * 45deg);
    transition: rotate 0.2s steps(2);
  }
  .knob-cap::before {
    content: '';
    position: absolute;
    inset: 6px;
    background: var(--plastic);
  }
  .knob-cap::after {
    content: '';
    position: absolute;
    left: calc(50% - 2px);
    top: 2px;
    width: 4px;
    height: 12px;
    background: var(--bezel);
  }
  .knob-btn {
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .knob-btn:hover .knob-cap::before {
    background: var(--plastic-hi);
  }
  .knob-btn:active .knob {
    translate: 0 2px;
  }
  .knob-btn:focus-visible {
    outline-offset: 2px;
  }
  .knob-cap[data-knob='vol'] {
    rotate: -60deg;
  }
  .knob-lbl {
    font-family: var(--font-pixel);
    font-size: 6px;
    letter-spacing: 0.08em;
    color: var(--bezel);
  }
  .tv-grille {
    flex: 1;
    align-self: stretch;
    min-height: 40px;
    background: repeating-linear-gradient(
      to bottom,
      var(--bezel) 0 3px,
      transparent 3px 7px
    );
    box-shadow: 0 0 0 3px var(--plastic-lo), 0 0 0 5px var(--plastic-dk);
    margin-inline: 5px;
  }
  .tv-btns {
    display: flex;
    gap: 6px;
  }
  .tv-btns span {
    width: 12px;
    height: 8px;
    background: var(--plastic);
    box-shadow:
      inset -2px -2px 0 var(--plastic-dk),
      0 2px 0 #000;
  }

  /* Tele angosta: los controles pasan a una fila bajo la pantalla */
  @container tv (max-width: 479px) {
    .tv-cabinet {
      grid-template-columns: minmax(0, 1fr);
    }
    .tv-side {
      flex-direction: row;
      justify-content: space-between;
      padding: 8px 12px;
    }
    .tv-brand,
    .tv-btns,
    .knob-lbl {
      display: none;
    }
    .knob {
      width: 32px;
      height: 32px;
    }
    .knob-cap {
      width: 24px;
      height: 24px;
    }
    .knob-cap::before {
      inset: 5px;
    }
    .knob-cap::after {
      height: 9px;
    }
    .tv-grille {
      min-height: 28px;
      min-width: 32px;
      margin-block: 3px;
    }
  }

  /* ---------- franja inferior y patas ---------- */
  .tv-base {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 6px 16px;
    font-family: var(--font-pixel);
    font-size: 7px;
    letter-spacing: 0.08em;
    color: var(--color-outline-variant);
  }
  .led {
    width: 8px;
    height: 8px;
    background: var(--color-error-container);
    box-shadow: 0 0 6px var(--color-error);
  }
  .tv-slot {
    flex: 1;
    height: 6px;
    background: var(--color-outline);
    box-shadow: inset 0 2px 0 var(--color-outline-variant);
  }
  .tv-feet {
    display: flex;
    justify-content: space-between;
    padding: 0 32px;
  }
  .tv-feet::before,
  .tv-feet::after {
    content: '';
    width: 48px;
    height: 10px;
    background: var(--plastic-lo);
    box-shadow: inset 0 -4px 0 var(--plastic-dk);
  }

  /* ---------- responsive ---------- */
  /* Debajo de 1024px no caben el estante a ×2 y una tele digna lado a lado:
     la tele pasa arriba a todo lo ancho. */
  @media (max-width: 1023px) {
    .pg-layout {
      grid-template-columns: 1fr;
    }
    .tv {
      order: -1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cart,
    .cart *,
    .tv-screen,
    .knob-cap {
      transition: none !important;
      animation: none !important;
    }
  }
</style>

<script>
  const root = document.getElementById('project-grid');
  const shelf = root?.querySelector<HTMLElement>('[data-shelf]');
  const screen = root?.querySelector<HTMLElement>('[data-screen]');
  const tv = root?.querySelector<HTMLElement>('[data-tv]');

  if (root && shelf && screen && tv) {
    const carts = [...shelf.querySelectorAll<HTMLButtonElement>('[data-cart]')];
    const panels = [...screen.querySelectorAll<HTMLElement>('[data-panel]')];
    const filters = [...root.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const mobile = matchMedia('(max-width: 1023px)');
    const ch = tv.querySelector<HTMLElement>('[data-ch]');
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    const nextCh = tv.querySelector<HTMLButtonElement>('[data-next-ch]');

    let current = carts.findIndex((c) => c.getAttribute('aria-pressed') === 'true');
    // Posición acumulada de la perilla (en pasos de 45°): así gira siempre
    // hacia adelante con la perilla aunque el canal dé la vuelta al final.
    let knob = current;

    const select = (i: number, turn = i - current) => {
      current = i;
      knob += turn;
      carts.forEach((c, k) => {
        c.setAttribute('aria-pressed', String(k === i));
        c.tabIndex = k === i ? 0 : -1;
      });
      panels.forEach((p, k) => p.toggleAttribute('data-active', k === i));

      // Cada cartucho es un canal: la perilla gira y el display lo muestra.
      tv.style.setProperty('--ch', String(knob));
      if (ch) ch.textContent = `CH${String(i + 1).padStart(2, '0')}`;

      if (!reducedMotion.matches) {
        screen.classList.remove('boot');
        void screen.offsetWidth; // reinicia la animación
        screen.classList.add('boot');
      }

      // En móvil la tele queda arriba del estante: si no se ve, la traemos.
      if (mobile.matches) {
        const r = tv.getBoundingClientRect();
        const offset = parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 0;
        if (r.top < offset || r.bottom > innerHeight) {
          tv.scrollIntoView({ block: 'start', behavior: reducedMotion.matches ? 'instant' : 'smooth' });
        }
      }
    };

    carts.forEach((c, i) => c.addEventListener('click', () => select(i)));

    // Perilla CH: siguiente cartucho visible según el filtro, con vuelta al
    // principio al llegar al último.
    nextCh?.addEventListener('click', () => {
      for (let k = 1; k <= carts.length; k++) {
        const j = (current + k) % carts.length;
        if (!carts[j].classList.contains('dim')) {
          select(j, 1);
          return;
        }
      }
    });

    // Flechas: mueven el foco por el grid (roving tabindex). Enter/Espacio
    // seleccionan porque cada cartucho es un <button>.
    shelf.addEventListener('keydown', (e) => {
      const i = carts.indexOf(document.activeElement as HTMLButtonElement);
      if (i < 0) return;
      const cols = getComputedStyle(shelf).gridTemplateColumns.split(' ').length;
      const step: Record<string, number> = {
        ArrowRight: 1,
        ArrowLeft: -1,
        ArrowDown: cols,
        ArrowUp: -cols,
        Home: -i,
        End: carts.length - 1 - i,
      };
      if (!(e.key in step)) return;
      e.preventDefault();
      const j = i + step[e.key];
      if (j < 0 || j >= carts.length) return;
      carts[i].tabIndex = -1;
      carts[j].tabIndex = 0;
      carts[j].focus();
    });

    filters.forEach((f) =>
      f.addEventListener('click', () => {
        const value = f.dataset.filter;
        filters.forEach((x) => x.setAttribute('aria-pressed', String(x === f)));
        carts.forEach((c) =>
          c.classList.toggle('dim', value !== 'ALL' && c.dataset.platform !== value),
        );
      }),
    );
  }
</script>
