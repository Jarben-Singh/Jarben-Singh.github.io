---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';

const [focus, tetris, land, cespe, rollback, classified] = projects;
const coverBase =
  'w-full h-36 border-2 flex items-center justify-center p-3 relative bg-[#050b42] border-primary-container';
---

<Layout>
  <div class="flex flex-col w-full">
    <Hero />

    <!-- LEVEL SELECT HEADER -->
    <section class="w-full mt-12 mb-6" id="project-grid">
      <div
        class="bg-surface-container border-4 border-outline-variant shadow-[4px_4px_0px_0px_#01043e] p-4 flex flex-col md:flex-row md:items-center justify-between gap-3"
      >
        <div class="flex items-center gap-3">
          <div
            class="w-7 h-7 bg-tertiary border-2 border-surface-container-lowest flex items-center justify-center shrink-0 shadow-[2px_2px_0_#01043e]"
          >
            <span
              class="font-pixel text-[10px] text-surface-container-lowest font-bold animate-pulse"
              >$</span
            >
          </div>
          <div>
            <div
              class="flex items-center gap-2 font-pixel text-[8px] text-tertiary-fixed uppercase tracking-wider"
            >
              <span>STAGE 01 — MISSION ARCHIVE</span>
              <span class="inline-block w-1.5 h-1.5 bg-primary-fixed"></span>
              <span>DIFFICULTY: HARD</span>
            </div>
            <h2 class="font-pixel text-sm sm:text-base text-primary-fixed tracking-wide mt-0.5">
              SELECT A PROJECT
            </h2>
          </div>
        </div>
        <div
          class="flex items-center gap-2 font-label-sm text-label-sm text-on-surface-variant self-end md:self-center"
        >
          <span>{projects.length} QUESTS REGISTERED</span>
          <div class="flex gap-1">
            {
              projects.map((_, i) => (
                <div
                  class:list={[
                    'w-2 h-3',
                    i < projects.length - 1 ? 'bg-primary-container' : 'bg-outline-variant',
                  ]}
                />
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- PROJECT GRID -->
    <section class="w-full grid grid-cols-1 md:grid-cols-2 gap-6">
      <ProjectCard project={focus}>
        <div slot="cover" class:list={[coverBase, 'flex-col']}>
          <div
            class="absolute top-2 left-2 flex items-center gap-1 bg-surface-container-high px-2 py-0.5 border border-outline"
          >
            <span class="material-symbols-outlined text-tertiary text-[14px]"
              >local_fire_department</span
            >
            <span class="font-pixel text-[8px] text-tertiary">STREAK: 14D</span>
          </div>
          <div
            class="absolute top-2 right-2 flex items-center gap-1 bg-surface-container-high px-2 py-0.5 border border-outline"
          >
            <span class="material-symbols-outlined text-secondary text-[14px]">diamond</span>
            <span class="font-pixel text-[8px] text-secondary">x250</span>
          </div>
          <div
            class="w-16 h-24 bg-surface-container-high border-2 border-tertiary-fixed p-1 flex flex-col items-center justify-between shadow-[2px_2px_0_#01043e]"
          >
            <div class="w-4 h-1 bg-outline-variant"></div>
            <div class="flex flex-col items-center gap-1">
              <span class="material-symbols-outlined text-tertiary-fixed text-[20px] animate-pulse"
                >timer</span
              >
              <span class="font-pixel text-[6px] text-on-surface">25:00</span>
            </div>
            <div class="w-2 h-2 rounded-full border border-outline-variant"></div>
          </div>
        </div>
      </ProjectCard>

      <ProjectCard project={tetris}>
        <div slot="cover" class:list={[coverBase, 'gap-6 overflow-hidden']}>
          <div class="flex flex-col gap-1 items-center">
            <div class="flex gap-1">
              <div class="w-4 h-4 bg-tertiary-fixed border border-surface-container-lowest"></div>
              <div class="w-4 h-4 bg-tertiary-fixed border border-surface-container-lowest"></div>
            </div>
            <div class="flex gap-1">
              <div class="w-4 h-4 bg-tertiary-fixed border border-surface-container-lowest"></div>
              <div class="w-4 h-4 bg-tertiary-fixed border border-surface-container-lowest"></div>
            </div>
          </div>
          <div
            class="w-20 h-24 bg-surface-container-high border-2 border-outline-variant p-2 flex flex-col justify-between shadow-[2px_2px_0_#01043e]"
          >
            <div
              class="w-full h-10 bg-primary-container border border-surface-container-lowest flex items-center justify-center"
            >
              <span class="font-pixel text-[6px] text-tertiary-fixed text-center">SNES TETRIS</span>
            </div>
            <div class="w-full flex justify-between gap-0.5">
              <div class="w-1.5 h-3 bg-outline-variant"></div>
              <div class="w-1.5 h-3 bg-outline-variant"></div>
              <div class="w-1.5 h-3 bg-outline-variant"></div>
              <div class="w-1.5 h-3 bg-outline-variant"></div>
            </div>
          </div>
          <div class="flex flex-col gap-1">
            <div class="w-4 h-4 bg-secondary border border-surface-container-lowest"></div>
            <div class="w-4 h-4 bg-secondary border border-surface-container-lowest"></div>
            <div class="w-4 h-4 bg-secondary border border-surface-container-lowest"></div>
          </div>
        </div>
      </ProjectCard>

      <ProjectCard project={land}>
        <div slot="cover" class:list={[coverBase]}>
          <div
            class="grid grid-cols-4 gap-1.5 p-2 bg-surface-container-high border border-outline-variant"
          >
            {
              ['L1', 'L2', 'SOLD', 'L4', 'SOLD', 'L6', 'L7', 'L8'].map((lot) =>
                lot === 'SOLD' ? (
                  <div class="w-7 h-6 bg-secondary-container border border-secondary flex items-center justify-center">
                    <span class="font-pixel text-[6px] text-tertiary-fixed">SOLD</span>
                  </div>
                ) : (
                  <div class="w-7 h-6 bg-emerald-600/60 border border-emerald-400 flex items-center justify-center">
                    <span class="font-pixel text-[6px] text-emerald-200">{lot}</span>
                  </div>
                ),
              )
            }
          </div>
          <div
            class="absolute bottom-2 right-4 bg-surface-container-lowest px-2 py-0.5 border border-primary-container"
          >
            <span class="font-pixel text-[7px] text-secondary">RANCHO DELGADO</span>
          </div>
        </div>
      </ProjectCard>

      <ProjectCard project={cespe}>
        <div slot="cover" class:list={[coverBase, 'gap-6']}>
          <div class="flex flex-col items-center">
            <div class="w-2 h-2 bg-primary-fixed"></div>
            <div class="w-4 h-2 bg-primary"></div>
            <div class="w-6 h-4 bg-primary-container border-x border-primary"></div>
            <div class="w-8 h-4 bg-primary-container border-b border-primary"></div>
          </div>
          <div
            class="bg-surface-container-high border-2 border-outline-variant p-2.5 flex flex-col gap-1 w-36 shadow-[2px_2px_0_#01043e]"
          >
            <div class="flex items-center justify-between">
              <span class="font-pixel text-[6px] text-tertiary">CESPE REP #402</span>
              <span class="w-1.5 h-1.5 bg-emerald-400"></span>
            </div>
            <div class="w-full h-1.5 bg-surface-container-lowest">
              <div class="w-3/4 h-full bg-secondary"></div>
            </div>
            <span class="font-pixel text-[6px] text-on-surface-variant">FLOW: NORMAL</span>
          </div>
        </div>
      </ProjectCard>

      <ProjectCard project={rollback}>
        <div slot="cover" class:list={[coverBase, 'flex-col justify-between']}>
          <div class="w-full flex justify-between items-center text-[8px] font-pixel">
            <span class="text-tertiary">P1 [LOCAL]</span>
            <span class="bg-surface-container px-1.5 py-0.5 border border-primary text-emerald-400"
              >PING: 12ms (0 ROLL)</span
            >
            <span class="text-primary-fixed">P2 [REMOTE]</span>
          </div>
          <div class="w-full flex items-end justify-around pb-1 relative">
            <div
              class="w-8 h-8 bg-primary-container border-2 border-primary-fixed shadow-[2px_2px_0_#01043e] flex items-center justify-center"
            >
              <div class="w-2 h-2 bg-tertiary-fixed"></div>
            </div>
            <div class="w-6 h-6 border border-dashed border-secondary/50"></div>
            <div
              class="w-8 h-8 bg-[#93000a] border-2 border-[#ffdad6] shadow-[2px_2px_0_#01043e] flex items-center justify-center"
            >
              <div class="w-2 h-2 bg-white"></div>
            </div>
          </div>
          <div class="w-full h-1 bg-outline-variant"></div>
        </div>
      </ProjectCard>

      <ProjectCard project={classified}>
        <div
          slot="cover"
          class="w-full h-36 bg-[#01043e] border-2 border-outline-variant flex flex-col items-center justify-center gap-2 p-3 relative"
        >
          <div
            class="w-10 h-12 bg-surface-container-high border-2 border-outline flex flex-col items-center justify-center p-1 relative shadow-[2px_2px_0_#01043e]"
          >
            <div class="w-6 h-5 border-2 border-outline -mt-6 rounded-t-sm bg-transparent"></div>
            <div class="w-2 h-3 bg-surface-container-lowest"></div>
          </div>
          <div class="font-pixel text-[8px] text-outline tracking-widest text-center mt-1">
            INSERT COIN TO UNLOCK
          </div>
          <div class="font-pixel text-[7px] text-tertiary-container animate-pulse">COMING SOON</div>
        </div>
      </ProjectCard>
    </section>

    <!-- WARP COMMAND -->
    <aside
      class="w-full mt-10 p-4 bg-surface-container border-4 border-[#0600AB] shadow-[4px_4px_0px_0px_#01043e]"
    >
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <span class="material-symbols-outlined text-secondary text-[24px]">terminal</span>
          <div>
            <div class="font-pixel text-[9px] text-tertiary-fixed">
              WARP COMMAND // STAGE SELECTION
            </div>
            <p class="font-label-sm text-label-sm text-on-surface-variant">
              Press START to initiate direct communication with Player 1
            </p>
          </div>
        </div>
        <a
          class="shrink-0 px-4 py-2 bg-primary-container text-tertiary-fixed font-pixel text-[9px] border-2 border-tertiary-fixed hover:bg-secondary-container transition-colors shadow-[2px_2px_0_#01043e]"
          href="#contact"
        >
          CONTACT JARED ▶
        </a>
      </div>
    </aside>
  </div>
</Layout>
