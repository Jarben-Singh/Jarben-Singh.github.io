---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ProjectSelector from '../components/ProjectSelector.astro';
---

<Layout>
  <div class="flex flex-col w-full">
    <Hero />

    <ProjectSelector />

    <!-- WARP COMMAND -->
    <aside
      class="w-full mt-10 p-4 bg-surface-container border-4 border-[#0600AB] shadow-[4px_4px_0px_0px_#01043e]"
    >
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <span class="material-symbols-outlined text-secondary text-[24px]">terminal</span>
          <div>
            <div class="font-pixel text-[9px] text-tertiary-fixed">
              WARP COMMAND // STAGE SELECTION
            </div>
            <p class="font-label-sm text-label-sm text-on-surface-variant">
              Press START to initiate direct communication with Player 1
            </p>
          </div>
        </div>
        <a
          class="shrink-0 px-4 py-2 bg-primary-container text-tertiary-fixed font-pixel text-[9px] border-2 border-tertiary-fixed hover:bg-secondary-container transition-colors shadow-[2px_2px_0_#01043e]"
          href="#contact"
        >
          CONTACT JARED ▶
        </a>
      </div>
    </aside>
  </div>
</Layout>
