---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Jared Delgado | Full-Stack Developer',
  description = 'Portafolio de Jared Delgado, estudiante de IngenierÃ­a de Software en CETYS Universidad, Ensenada, MÃ©xico.',
} = Astro.props;

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href={`${base}img/logo.png`} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Press+Start+2P&family=Space+Grotesk:wght@600;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    class="bg-surface-container-lowest font-body-md text-on-surface antialiased selection:bg-tertiary-fixed selection:text-surface-container-lowest min-h-screen relative overflow-x-clip"
  >
    <Header />
    <main class="w-full pt-20 relative z-20 bg-transparent min-h-[calc(100vh-18rem)]">
      <div class="max-w-[960px] mx-auto px-margin-mobile md:px-gutter py-space-lg">
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>
